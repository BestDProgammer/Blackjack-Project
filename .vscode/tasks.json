{
    "tasks": [
        {
            "type": "process",
            "label": "CMake: build project",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
            "dependsOn": "CMake: configure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the complete project with its Qt include paths and libraries."
        },
        {
            "type": "process",
            "label": "CMake: configure",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build"],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}
